#!/usr/bin/env sh

echo "🔍 [pre-commit] Running pre-commit checks..."

# ─── 1. Collect staged formattable files ────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|css|json|md|yml|yaml|html)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No formattable files staged — skipping Prettier."
  exit 0
fi

# ─── 2. Run Prettier over staged files ──────────────────────────────────────
echo "✨ Running Prettier on staged files..."
echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 npx prettier --write --ignore-unknown

# ─── 3. Detect if Prettier changed anything (unstaged diff) ─────────────────
PRETTIER_CHANGED=$(git diff --name-only || true)

if [ -n "$PRETTIER_CHANGED" ]; then
  echo ""
  echo "🎨 Prettier reformatted the following files:"
  echo "$PRETTIER_CHANGED" | sed 's/^/   → /'
  echo ""
  echo "📦 Creating autopretify commit..."

  # Stage only the files that prettier changed
  echo "$PRETTIER_CHANGED" | tr '\n' '\0' | xargs -0 git add

  # Create the auto-commit (--no-verify skips this hook for the auto-commit)
  git commit -m "style(autopretify): auto-formatted code [skip ci]" --no-verify

  echo "✅ autopretify commit created."
  echo ""

  # Re-stage the original files so the user's commit still includes them
  echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 git add
fi

# ─── 4. Run lint-staged for any remaining linting ───────────────────────────
npx lint-staged

echo "✅ [pre-commit] All checks passed!"
